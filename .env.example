# 复制为 .env 后按需修改：cp .env.example .env
# 这个文件只作为 docker compose 的变量来源，不会被整体注入容器，
# 实际传给容器的是 docker-compose.yml 里 environment 段显式列出的那几项。

# 镜像 tag，取 build-image.sh 推送时用的版本号；latest 表示跟随最新构建
CFDATA_TAG=latest

# 宿主机暴露端口。容器内固定监听 13335，改这里只影响宿主机侧
CFDATA_HOST_PORT=13335

# ============ Web 认证（默认关闭） ============
# 公网部署请务必设置，否则任何人都能直接使用你的服务器跑扫描和测速。
# 用户名与密码需同时设置才会启用认证；两个都留空即维持无认证状态。
# 密码里若含 $ 必须写成 $$，否则会被 compose 当作变量插值截断，症状是密码填对了却登不进去。
CFDATA_USER=
CFDATA_PASSWORD=

# 登录会话有效期（分钟）
CFDATA_SESSION=720

# 调试等级，留空表示关闭；可选 error（仅错误）、all（全部日志）
# 调试日志写入容器的 /app/data/cfdata-debug.log，随数据卷一起持久化
CFDATA_DEBUG=

# 跳过地区/代理环境验证，留空表示不跳过；设为 true 时启动不再提示代理警告
CFDATA_SKIPGEO=
